<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- فید لوکال برای تست مصرف پکیج در پروژه‌های دیگر قبل از انتشار رسمی -->
    <add key="local-feed" value="./local-feed" />
  </packageSources>
</configuration>
